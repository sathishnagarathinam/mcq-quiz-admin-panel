# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'

      # Fix for leveldb-library port issue
      if target.name == 'leveldb-library'
        config.build_settings['HEADER_SEARCH_PATHS'] = '$(inherited) "${PODS_TARGET_SRCROOT}/port"'
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = '$(inherited) LEVELDB_PLATFORM_POSIX=1'
      end

      # Ultra-aggressive fix for unsupported option '-G' error
      config.build_settings['GCC_GENERATE_DEBUGGING_SYMBOLS'] = 'NO'
      config.build_settings['DEBUG_INFORMATION_FORMAT'] = ''
      config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'

      # Nuclear option: Remove ALL possible flag settings
      flags_to_remove = [
        'OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS', 'OTHER_LDFLAGS', 'OTHER_SWIFT_FLAGS',
        'GCC_PREPROCESSOR_DEFINITIONS', 'WARNING_CFLAGS', 'GCC_WARN_ABOUT_DEPRECATED_FUNCTIONS',
        'SWIFT_ACTIVE_COMPILATION_CONDITIONS', 'GCC_SYMBOLS_PRIVATE_EXTERN',
        'CLANG_DEBUG_INFORMATION_LEVEL', 'CLANG_GENERATE_DEBUGGING_SYMBOLS',
        'COPY_PHASE_STRIP', 'STRIP_INSTALLED_PRODUCT', 'SEPARATE_STRIP',
        'DEPLOYMENT_POSTPROCESSING', 'STRIP_STYLE'
      ]

      flags_to_remove.each { |flag| config.build_settings.delete(flag) }

      # Set all flag arrays to empty
      config.build_settings['OTHER_CFLAGS'] = ''
      config.build_settings['OTHER_CPLUSPLUSFLAGS'] = ''
      config.build_settings['OTHER_LDFLAGS'] = ''
      config.build_settings['OTHER_SWIFT_FLAGS'] = ''
      config.build_settings['WARNING_CFLAGS'] = ''
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = ''

      # Simplified architecture settings - only arm64 for simulator
      config.build_settings['ARCHS'] = 'arm64'
      config.build_settings['VALID_ARCHS'] = 'arm64'
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386 x86_64'

      # Disable ALL debugging and optimization
      config.build_settings['GCC_OPTIMIZATION_LEVEL'] = '0'
      config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Onone'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['CLANG_ENABLE_CODE_COVERAGE'] = 'NO'
      config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
      config.build_settings['ENABLE_TESTABILITY'] = 'NO'
      config.build_settings['GCC_GENERATE_TEST_COVERAGE_FILES'] = 'NO'
      config.build_settings['GCC_INSTRUMENT_PROGRAM_FLOW_ARCS'] = 'NO'
      config.build_settings['CLANG_ENABLE_OBJC_ARC'] = 'YES'

      # Disable all warnings and modular headers
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      config.build_settings['DEFINES_MODULE'] = 'YES'
      config.build_settings['CLANG_WARN_STRICT_PROTOTYPES'] = 'NO'
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['CLANG_WARN_DOCUMENTATION_COMMENTS'] = 'NO'
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      config.build_settings['CLANG_WARN_COMMA'] = 'NO'
      config.build_settings['CLANG_WARN_UNGUARDED_AVAILABILITY'] = 'NO'
      config.build_settings['CLANG_WARN_DIRECT_OBJC_ISA_USAGE'] = 'NO'
      config.build_settings['CLANG_WARN_OBJC_ROOT_CLASS'] = 'NO'
      config.build_settings['GCC_WARN_64_TO_32_BIT_CONVERSION'] = 'NO'
      config.build_settings['GCC_WARN_ABOUT_RETURN_TYPE'] = 'NO'
      config.build_settings['GCC_WARN_UNDECLARED_SELECTOR'] = 'NO'
      config.build_settings['GCC_WARN_UNINITIALIZED_AUTOS'] = 'NO'
      config.build_settings['GCC_WARN_UNUSED_FUNCTION'] = 'NO'
      config.build_settings['GCC_WARN_UNUSED_VARIABLE'] = 'NO'

      # Fix leveldb-library compilation issues
      if target.name == 'leveldb-library'
        config.build_settings['HEADER_SEARCH_PATHS'] = '$(inherited) "${PODS_TARGET_SRCROOT}" "${PODS_TARGET_SRCROOT}/include" "${PODS_TARGET_SRCROOT}/port"'
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = '$(inherited) LEVELDB_PLATFORM_POSIX=1 OS_MACOSX=1'
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = '$(inherited) -DLEVELDB_PLATFORM_POSIX=1 -DOS_MACOSX=1 -Wno-error'
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['CLANG_WARN_EVERYTHING'] = 'NO'
      end

      # Fix GoogleDataTransport compilation issues
      if target.name == 'GoogleDataTransport'
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['CLANG_WARN_EVERYTHING'] = 'NO'
        config.build_settings['OTHER_CFLAGS'] = '$(inherited) -Wno-error -Wno-implicit-function-declaration'
      end

      # Fix Firebase version definition issues
      if target.name.start_with?('Firebase')
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = '$(inherited) Firebase_VERSION=11.15.0'
        config.build_settings['OTHER_CFLAGS'] = '$(inherited) -DFirebase_VERSION=11.15.0'
      end

      # Fix nanopb/protobuf issues
      if target.name == 'nanopb'
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['CLANG_WARN_EVERYTHING'] = 'NO'
        config.build_settings['OTHER_CFLAGS'] = '$(inherited) -Wno-error'
      end

      # Global fixes for all targets
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      config.build_settings['OTHER_LDFLAGS'] = '$(inherited) -framework Foundation -lc++'
    end
  end
end
