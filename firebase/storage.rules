rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User profile images
    match /profile_images/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Question images (admin only) - Check admin_users collection for web admin
    match /question_images/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        // Check mobile app admin users
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'master_admin']) ||
        // Check web admin users
        (firestore.exists(/databases/(default)/documents/admin_users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/admin_users/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'system_admin'] &&
         firestore.get(/databases/(default)/documents/admin_users/$(request.auth.uid)).data.isActive == true)
      );
    }
    
    // Category banners (admin only) - Check admin_users collection for web admin
    match /category_banners/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        // Check mobile app admin users
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'master_admin']) ||
        // Check web admin users
        (firestore.exists(/databases/(default)/documents/admin_users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/admin_users/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'system_admin'] &&
         firestore.get(/databases/(default)/documents/admin_users/$(request.auth.uid)).data.isActive == true)
      );
    }

    // Bulk upload files (admin only) - Check admin_users collection for web admin
    match /bulk_uploads/{allPaths=**} {
      allow read, write: if request.auth != null && (
        // Check mobile app admin users
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'master_admin']) ||
        // Check web admin users
        (firestore.exists(/databases/(default)/documents/admin_users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/admin_users/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'system_admin'] &&
         firestore.get(/databases/(default)/documents/admin_users/$(request.auth.uid)).data.isActive == true)
      );
    }

    // App assets - Check admin_users collection for web admin
    match /app_assets/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        // Check mobile app admin users
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'master_admin']) ||
        // Check web admin users
        (firestore.exists(/databases/(default)/documents/admin_users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/admin_users/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'system_admin'] &&
         firestore.get(/databases/(default)/documents/admin_users/$(request.auth.uid)).data.isActive == true)
      );
    }

    // Exam Hub files (admin only) - Check admin_users collection for web admin
    match /exam_hub/{category}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        category in ['news', 'tips', 'papers', 'results'] && (
        // Check mobile app admin users
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'master_admin']) ||
        // Check web admin users
        (firestore.exists(/databases/(default)/documents/admin_users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/admin_users/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'system_admin'] &&
         firestore.get(/databases/(default)/documents/admin_users/$(request.auth.uid)).data.isActive == true)
      );
    }
  }
}
